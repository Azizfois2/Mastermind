{
  "files.associations": {
    "*.h": "c",
    "*.rc": "cpp"
  },
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src",
    "${workspaceFolder}/resources"
  ],
  "C_Cpp.default.compilerPath": "C:/MinGW/bin/gcc.exe",
  "C_Cpp.default.cStandard": "c99",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x86"
}
